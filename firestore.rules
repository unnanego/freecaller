rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Roster is readable by the whole (signed-in) family — that's the point
    // of the app. Writes go through the admin tool (Admin SDK bypasses rules).
    match /users/{uid} {
      allow read: if signedIn();
      // The owner may edit only their own display name; everything else is
      // provisioned by the admin tool (Admin SDK bypasses rules).
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow create, delete: if false;

      // Push tokens: owner-only.
      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Private per-user secrets (login code): the owner may read theirs; only
      // functions write. Never exposed to other users, unlike the user doc.
      match /private/{doc} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /calls/{callId} {
      function isParticipant(data) {
        return request.auth.uid == data.callerId || request.auth.uid == data.calleeId;
      }
      function legalTransition() {
        let from = resource.data.state;
        let to = request.resource.data.state;
        return (from == 'ringing' && to in ['accepted', 'declined', 'cancelled', 'missed'])
            || (from == 'accepted' && to == 'ended')
            || (from == to);
      }

      allow read: if signedIn() && isParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.state == 'ringing'
        && request.resource.data.callerId != request.resource.data.calleeId;
      allow update: if signedIn()
        && isParticipant(resource.data)
        // Participants and callId-derived fields are immutable.
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && legalTransition();
      allow delete: if false;
    }

    // In-app child-safety reports: any signed-in user may file one; clients
    // never read or modify them (reviewed out-of-band via the Admin SDK).
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Function-only (Admin SDK): clients never touch codes directly.
    match /activationCodes/{code} {
      allow read, write: if false;
    }
    match /loginCodes/{code} {
      allow read, write: if false;
    }
  }
}
