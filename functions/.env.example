# Copy to functions/.env (gitignored). Non-secret function params.
# Secrets (LIVEKIT_API_KEY, LIVEKIT_API_SECRET, APNS_AUTH_KEY) live in
# Secret Manager via `firebase functions:secrets:set`, NOT here.
LIVEKIT_URL=wss://livekit.YOURDOMAIN.com
APNS_BUNDLE_ID=com.unnanego.freecaller
# "production" for TestFlight/App Store builds, else sandbox
APNS_ENV=sandbox
APNS_KEY_ID=PENDING
APNS_TEAM_ID=PENDING
