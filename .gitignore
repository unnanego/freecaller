# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
lib/l10n/app_localizations*.dart

# Node (Cloud Functions + admin tools)
node_modules/
tools/*.js

# Firebase secrets (never commit). The mobile config files
# (google-services.json / GoogleService-Info.plist) and firebase_options.dart
# are client config, not secrets, and ARE committed — security is enforced by
# Firestore rules + custom-token-only auth, not by hiding these.
*-service-account*.json

# Self-hosted LiveKit — real configs hold the API secret / domain
deploy/livekit/livekit.yaml

# Self-hosted PocketBase — real configs hold the APNs key id, LiveKit API
# secret and coturn shared secret. Only the *.example templates are committed;
# the live files live in /etc/freecaller on the server.
deploy/pocketbase/push/push.json
deploy/pocketbase/livekit/livekit.json
# The real roster: family names, phone numbers and sign-in addresses.
deploy/pocketbase/roster.json
# Fixed App Store reviewer codes — live copy is /etc/freecaller/review-otp.json
deploy/pocketbase/review-otp.json

# The retired Firebase backend. Its source is gone from the tree (git history
# has it), but the local build output, node_modules and — importantly — the
# .env holding the deployed functions' secrets stay on disk: build 8 is still
# under App Store review against that backend, so it must remain patchable.
functions/
deploy/pocketbase/**/*.p8
deploy/pocketbase/**/fcm.json
