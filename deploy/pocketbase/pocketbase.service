[Unit]
Description=PocketBase (freecaller backend)
After=network.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
ExecStart=/opt/pocketbase/pocketbase serve --http=127.0.0.1:8090 --dir=/var/lib/pocketbase/pb_data --hooksDir=/var/lib/pocketbase/pb_hooks --migrationsDir=/var/lib/pocketbase/pb_migrations
Restart=always
RestartSec=5
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocketbase /var/lib/freecaller

[Install]
WantedBy=multi-user.target
