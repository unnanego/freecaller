{
  "_comment": [
    "Template for /etc/freecaller/push.json on the PocketBase host.",
    "NEVER commit the real file or the keys it points at.",
    "Install:  root:pocketbase, chmod 640 (the hook runs as the pocketbase user).",
    "",
    "apns.env: 'production' for App Store / TestFlight builds,",
    "          'sandbox' for builds signed with a development profile.",
    "          Wrong value = APNs returns 400 BadDeviceToken for valid tokens.",
    "apns.watchBundleId: the Apple Watch app (docs/watch-plan.md). Same key,",
    "          same team — only the push topic differs. Leave it out and",
    "          watch devices fail to push with a clear error; phones are unaffected."
  ],

  "apns": {
    "keyPath": "/etc/freecaller/apns.p8",
    "keyId": "REPLACE_WITH_APNS_KEY_ID",
    "teamId": "R9577QC7DM",
    "bundleId": "com.unnanego.freecaller",
    "watchBundleId": "com.unnanego.freecaller.watchkitapp",
    "env": "production"
  },

  "fcm": {
    "serviceAccountPath": "/etc/freecaller/fcm.json"
  }
}
