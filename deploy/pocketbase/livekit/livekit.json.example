{
  "_comment": [
    "Template for /etc/freecaller/livekit.json on the PocketBase host.",
    "NEVER commit the real file. Install: root:pocketbase, chmod 640.",
    "",
    "livekit.apiKey / apiSecret must match /etc/livekit/livekit.yaml on this host.",
    "Changing them requires restarting livekit AND updating this file together,",
    "or token minting silently produces tokens the SFU rejects.",
    "",
    "turn.sharedSecret must match `static-auth-secret` in /etc/turnserver.conf.",
    "Leave turn.urls empty to disable the relay (clients then go direct only).",
    "",
    "Keep the plain turn: urls next to turns:. libwebrtc checks the turns:",
    "certificate against its own built-in roots (no Let's Encrypt among them),",
    "so a certificate it does not trust silently removes that relay."
  ],

  "livekit": {
    "apiKey": "REPLACE_WITH_LIVEKIT_API_KEY",
    "apiSecret": "REPLACE_WITH_LIVEKIT_API_SECRET",
    "url": "wss://lk.holographica.space"
  },

  "turn": {
    "urls": [
      "turns:turn.holographica.space:443",
      "turn:turn.holographica.space:3478?transport=udp",
      "turn:turn.holographica.space:3478?transport=tcp"
    ],
    "sharedSecret": "REPLACE_WITH_COTURN_STATIC_AUTH_SECRET"
  }
}
