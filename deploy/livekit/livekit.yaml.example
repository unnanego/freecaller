# Copy to livekit.yaml and fill in. livekit.yaml is gitignored (holds the
# API secret). Generate a key/secret pair with:
#   docker run --rm livekit/livekit-server generate-keys
#
# Signaling (port 7880) is proxied by nginx over WSS and is NOT exposed on
# the firewall. Media reaches the server directly on the UDP range + TCP
# fallback below.
port: 7880
rtc:
  # TCP fallback for clients whose network blocks UDP.
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
redis:
  address: 127.0.0.1:6379
keys:
  # APIxxxxxxxxxxxx: <secret from generate-keys>
  REPLACE_API_KEY: REPLACE_API_SECRET
# No embedded TURN: the SFU has a public IP, so direct UDP media + the TCP
# fallback cover home wifi and cellular. (If a user is ever on a network
# that blocks everything but TCP 443, see README "Restrictive networks".)
turn:
  enabled: false
