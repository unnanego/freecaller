<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Contact discovery: match the address book against registered users. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- Incoming-call ring: full-screen over the lock screen (Android 14+
         auto-grants this only to calling apps; also declared in Play Console). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Self-managed ConnectionService + in-call foreground service. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>

    <application
        android:label="Звонилка"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- singleInstance is load-bearing for answering calls, and it stays.
             It was tried as singleTask so that the photo picker could return its
             result (a singleInstance activity is the only member its task can
             hold, so anything started for a result is pushed into another task
             and its answer never comes back — the picker opened and then
             silently did nothing). Calls then dropped the instant they were
             answered: the accept intent re-enters MainActivity with CLEAR_TOP,
             which under singleTask lands in the same task as the callkit
             activity and takes the Dart side down with the call, Telecom going
             ACTIVE -> DISCONNECTED inside half a second.
             A call that cannot be answered is the whole app; setting a photo
             from an Android phone is not. If the picker is worth fixing it has
             to be done without moving this activity out of its own task. -->
        <!-- Ordinary launch mode, deliberately: this is the activity that CAN
             receive a result, so the photo picker it starts answers it instead
             of vanishing into another task. Invisible and kept out of Recents —
             it exists for the moment a picker is on screen and finishes. -->
        <activity
            android:name=".PhotoPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Where the camera writes its capture before we scale it down. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Native FCM handler: dismisses a cancelled ring's full-screen
             activity (the plugin's dismiss can't); forwards everything else to
             the Flutter background handler. Higher priority than the default. -->
        <service
            android:name=".FreecallerMessagingService"
            android:exported="false">
            <intent-filter android:priority="1">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
